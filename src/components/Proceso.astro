---
const pasos = [
  {
    num: '01', badge: 'Gratis',
    icon: 'M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z',
    titulo: 'Diagnóstico gratuito',
    subtitulo: '30 minutos',
    desc: 'Analizamos tu negocio, identificamos los puntos de fuga de ingresos y te mostramos cuánto estás perdiendo sin automatización. Sin compromiso ni letra pequeña.',
  },
  {
    num: '02', badge: '7-14 días',
    icon: 'M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z',
    titulo: 'Implementación express',
    subtitulo: '7 a 14 días',
    desc: 'Nuestro equipo configura todos los sistemas, los entrena con tu información e integra con las herramientas que ya usas. Sin que toques código.',
  },
  {
    num: '03', badge: 'Día 1',
    icon: 'M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941',
    titulo: 'Resultados desde el día 1',
    subtitulo: 'Desde el primer día',
    desc: 'El sistema empieza a trabajar desde que se activa. Primeros leads respondidos, primeras citas agendadas, primeros flujos ejecutados.',
  },
];
---

<section id="como-funciona" class="py-24 overflow-hidden" style="background:#1A1033;color:#F0F0FF">
  <div class="max-w-5xl mx-auto px-6 lg:px-10">

    <div class="text-center mb-16">
      <div class="reveal mb-4 flex justify-center">
        <span class="dark-label">Proceso</span>
      </div>
      <h2 class="reveal reveal-delay-1 font-display font-extrabold leading-tight"
          style="font-size:clamp(1.8rem,3.5vw,2.6rem);color:#F0F0FF">
        Tres pasos.<br/>
        <span class="gradient-text">Sin complicaciones.</span>
      </h2>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      {pasos.map((p, i) => (
        <div class={`reveal reveal-delay-${i+1} paso-card`}>
          <div class="flex items-center justify-between mb-5">
            <div class="step-num">{p.num}</div>
            <span class="step-badge">{p.badge}</span>
          </div>
          <div class="step-icon mb-4">
            <svg width="22" height="22" fill="none" stroke="#C084FC" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={p.icon}/>
            </svg>
          </div>
          <h3 class="font-display font-bold text-xl mb-1" style="color:#F0F0FF">{p.titulo}</h3>
          <p class="text-sm font-semibold mb-3" style="color:#C084FC">{p.subtitulo}</p>
          <p class="text-sm leading-relaxed" style="color:rgba(240,240,255,0.55)">{p.desc}</p>
        </div>
      ))}
    </div>

    <div class="reveal reveal-delay-4 text-center mt-12">
      <a href="#agenda" class="btn-primary">
        Empezar con el diagnóstico gratuito
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .dark-label {
    display: inline-flex; align-items: center;
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.73rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #C084FC; background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 99px; padding: 0.3rem 0.9rem;
  }
  .paso-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(192,132,252,0.15);
    border-radius: 1.25rem; padding: 2rem;
    transition: border-color 0.25s, background 0.25s;
  }
  .paso-card:hover { border-color: rgba(192,132,252,0.35); background: rgba(255,255,255,0.06); }
  .step-num {
    width: 44px; height: 44px; border-radius: 50%;
    border: 1.5px solid rgba(192,132,252,0.5);
    background: rgba(192,132,252,0.08);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 0.8rem; color: #C084FC;
  }
  .step-badge {
    font-family: 'Poppins', sans-serif; font-size: 0.62rem; font-weight: 600;
    color: #C084FC; background: rgba(192,132,252,0.1);
    border: 1px solid rgba(192,132,252,0.2);
    border-radius: 99px; padding: 0.15rem 0.55rem; white-space: nowrap;
  }
  .step-icon {
    width: 48px; height: 48px;
    background: rgba(192,132,252,0.08); border: 1px solid rgba(192,132,252,0.15);
    border-radius: 0.75rem;
    display: flex; align-items: center; justify-content: center;
  }
</style>

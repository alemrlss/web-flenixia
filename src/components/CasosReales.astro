---
const casos = [
  {
    ingreso: '+€11.400',
    periodo: 'mensuales adicionales',
    sector: 'E-commerce · Madrid',
    desc: 'Tienda online que perdía leads por respuesta lenta. Tras implementar el agente chat + workflows, recuperaron oportunidades que antes se perdían fuera de horario.',
    metricas: ['+34% conversión', '1h → 28s respuesta', '×2.4 leads atendidos'],
  },
  {
    ingreso: '+€18.900',
    periodo: 'mensuales adicionales',
    sector: 'Clínica estética · Barcelona',
    desc: 'Clínica con agenda desorganizada y seguimiento manual. El agente de voz + sistema de citas eliminó el no-show y triplicó la capacidad de gestión.',
    metricas: ['-62% no-shows', 'Agenda 24/7', '+3 consultas/día'],
  },
  {
    ingreso: '+€7.200',
    periodo: 'mensuales adicionales',
    sector: 'Asesoría financiera · Valencia',
    desc: 'Consultora que no hacía seguimiento sistemático. Los workflows de nurturing automatizaron el proceso y mantuvieron el contacto hasta el cierre.',
    metricas: ['+58% cierre', '14 → 5 días ciclo', '0 leads sin seguimiento'],
  },
];
---

<section id="casos" class="py-24 overflow-hidden" style="background:#FFFFFF;color:#1F1635">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">

    <div class="text-center mb-16">
      <div class="reveal mb-4 flex justify-center">
        <span class="section-label">Casos reales</span>
      </div>
      <h2 class="reveal reveal-delay-1 font-display font-extrabold leading-tight"
          style="font-size:clamp(1.8rem,3.5vw,2.6rem);color:#1F1635">
        Empresas reales, ingresos reales<br/>
        <span class="gradient-text">recuperados con Plenixia.</span>
      </h2>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">
      {casos.map((c, i) => (
        <div class={`reveal reveal-delay-${Math.min(i+1,4)} caso-card`}>
          <div class="mb-4">
            <div class="font-display font-black gradient-text" style="font-size:clamp(2rem,3.5vw,2.5rem);line-height:1">{c.ingreso}</div>
            <p class="text-sm" style="color:#64647A">{c.periodo}</p>
          </div>
          <div class="caso-divider mb-4"></div>
          <p class="caso-sector mb-3">{c.sector}</p>
          <p class="text-sm leading-relaxed mb-5" style="color:#64647A">{c.desc}</p>
          <ul class="space-y-2">
            {c.metricas.map(m => (
              <li class="flex items-center gap-2 text-sm" style="color:#374151">
                <svg width="13" height="13" fill="none" stroke="#9333EA" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
                {m}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .caso-card {
    background: #FFFFFF;
    border: 1px solid #EDE9FE;
    border-radius: 1.25rem; padding: 2rem;
    box-shadow: 0 2px 12px rgba(147,51,234,0.05);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }
  .caso-card:hover {
    border-color: rgba(147,51,234,0.35);
    box-shadow: 0 16px 48px rgba(147,51,234,0.1);
    background: rgba(255,255,255,0.06);
    transform: translateY(-4px);
  }
  .caso-divider { height: 1px; background: linear-gradient(90deg, #9333EA, transparent); opacity: 0.4; }
  .caso-sector {
    font-family: 'Poppins', sans-serif; font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: #9333EA;
  }
</style>

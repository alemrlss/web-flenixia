---

<section class="py-16 overflow-hidden" style="background:#FFFFFF; border-bottom:1px solid #EDE9FE">
  <div class="max-w-5xl mx-auto px-6 lg:px-10">

    <div class="text-center mb-12">
      <div class="reveal mb-3 flex justify-center">
        <span class="section-label">En cifras</span>
      </div>
      <h2 class="reveal reveal-delay-1 font-display font-bold leading-snug"
          style="font-size:clamp(1.3rem,2.6vw,1.7rem); color:#1F1635">
        Esto es lo que ya estamos construyendo —<br/>
        <span class="gradient-text">medido en resultados reales.</span>
      </h2>
    </div>

    <div class="impacto-ribbon">
      {stats.map((s, i) => (
        <div class={`reveal reveal-delay-${Math.min(i+2,4)} impacto-item`}>
          <div class="impacto-icon mb-3">
            <svg width="18" height="18" fill="none" stroke="#9333EA" stroke-width="1.6" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
            </svg>
          </div>
          <span class="impacto-num gradient-text">{s.num}</span>
          <span class="impacto-label">{s.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .impacto-ribbon {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
  }
  .impacto-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
    padding: 0.5rem 2.5rem;
    border-right: 1px solid #EDE9FE;
  }
  .impacto-item:last-child { border-right: none; }
  @media (max-width: 640px) {
    .impacto-item { width: 50%; border-right: none; padding: 1rem; }
  }
  .impacto-icon {
    width: 40px; height: 40px;
    background: #F3E8FF;
    border: 1px solid #DDD6FE;
    border-radius: 0.7rem;
    display: flex; align-items: center; justify-content: center;
  }
  .impacto-num {
    font-family: 'Poppins', sans-serif; font-weight: 800;
    font-size: clamp(2.1rem, 4.2vw, 2.85rem); line-height: 1;
  }
  .impacto-label {
    font-family: 'Poppins', sans-serif; font-size: 0.8rem; font-weight: 500;
    color: #64647A;
  }
</style>

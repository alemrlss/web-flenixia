---

<section class="py-24 overflow-hidden" style="background:#1A1033;color:#F0F0FF">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">

    <div class="text-center mb-14">
      <div class="reveal mb-4 flex justify-center">
        <span class="dark-label">Multisector</span>
      </div>
      <h2 class="reveal reveal-delay-1 font-display font-extrabold leading-tight mb-4"
          style="font-size:clamp(1.8rem,3.5vw,2.6rem);color:#F0F0FF">
        Empresas de todos los sectores<br/>
        <span class="gradient-text">confían en Flenixia.</span>
      </h2>
      <p class="reveal reveal-delay-2 text-lg max-w-xl mx-auto" style="color:rgba(240,240,255,0.55)">
        Cada sector tiene su propio cuello de botella. Adaptamos el sistema al tuyo — no al revés.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {sectores.map((s, i) => (
        <div class={`reveal reveal-delay-${Math.min(i+1,4)} sector-card`}>
          <div class="sector-icon mb-4">
            <svg width="20" height="20" fill="none" stroke="#C084FC" stroke-width="1.75" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
            </svg>
          </div>
          <h3 class="sector-name mb-2">{s.name}</h3>
          <p class="sector-desc">{s.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .dark-label {
    display: inline-flex; align-items: center;
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.73rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #C084FC;
    background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 99px; padding: 0.3rem 0.9rem;
  }
  .sector-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(192,132,252,0.18);
    border-radius: 1.25rem;
    padding: 1.75rem;
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
  }
  .sector-card:hover {
    border-color: rgba(192,132,252,0.4);
    background: rgba(255,255,255,0.05);
    transform: translateY(-3px);
  }
  .sector-icon {
    width: 42px; height: 42px;
    background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 0.75rem;
    display: flex; align-items: center; justify-content: center;
  }
  .sector-name {
    font-family: 'Poppins', sans-serif; font-weight: 700;
    font-size: 1rem; color: #F5F3FF;
  }
  .sector-desc {
    font-family: 'Inter', sans-serif; font-size: 0.85rem; line-height: 1.6;
    color: rgba(240,240,255,0.55);
  }
</style>

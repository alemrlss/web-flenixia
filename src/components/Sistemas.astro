---

<section id="soluciones" class="py-24 overflow-hidden" style="background:#1A1033;color:#F0F0FF">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">

    <div class="text-center mb-16">
      <div class="reveal mb-4 flex justify-center">
        <span class="dark-label">6 sistemas integrados</span>
      </div>
      <h2 class="reveal reveal-delay-1 font-display font-extrabold leading-tight mb-4"
          style="font-size:clamp(1.8rem,3.5vw,2.6rem);color:#F0F0FF">
        Todo lo que tu negocio necesita,<br/>
        <span class="gradient-text">automatizado con IA.</span>
      </h2>
      <p class="reveal reveal-delay-2 text-lg max-w-xl mx-auto" style="color:rgba(240,240,255,0.55)">
        Seis sistemas integrados para empresas que quieren crecer sin multiplicar plantilla.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {sistemas.map((s, i) => (
        <div class={`reveal reveal-delay-${Math.min(i+1,4)} sistema-card`}>
          <div class="flex items-start justify-between mb-4">
            <div class="sistema-icon">
              <svg width="20" height="20" fill="none" stroke="#C084FC" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
              </svg>
            </div>
            <span class="sistema-tag">{s.tag}</span>
          </div>
          <h3 class="font-display font-bold text-lg mb-2" style="color:#F0F0FF">{s.name}</h3>
          <p class="text-sm leading-relaxed mb-4" style="color:rgba(240,240,255,0.55)">{s.desc}</p>
          <ul class="space-y-1.5">
            {s.features.map(f => (
              <li class="flex items-center gap-2 text-xs" style="color:rgba(240,240,255,0.45)">
                <span class="feat-dot"></span>{f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .dark-label {
    display: inline-flex; align-items: center;
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.73rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #C084FC;
    background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 99px; padding: 0.3rem 0.9rem;
  }
  .sistema-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(192,132,252,0.15);
    border-radius: 1.25rem; padding: 1.75rem;
    transition: border-color 0.25s, background 0.25s, transform 0.25s;
    position: relative; overflow: hidden;
  }
  .sistema-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0;
    height: 1px; background: linear-gradient(90deg, transparent, rgba(192,132,252,0.4), transparent);
    opacity: 0; transition: opacity 0.25s;
  }
  .sistema-card:hover {
    border-color: rgba(192,132,252,0.35);
    background: rgba(255,255,255,0.06);
    transform: translateY(-3px);
  }
  .sistema-card:hover::before { opacity: 1; }
  .sistema-icon {
    width: 44px; height: 44px;
    background: rgba(192,132,252,0.1); border: 1px solid rgba(192,132,252,0.2);
    border-radius: 0.75rem;
    display: flex; align-items: center; justify-content: center;
  }
  .sistema-tag {
    font-family: 'Poppins', sans-serif; font-size: 0.65rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: #C084FC; background: rgba(192,132,252,0.1);
    border: 1px solid rgba(192,132,252,0.2);
    border-radius: 99px; padding: 0.2rem 0.6rem;
  }
  .feat-dot { width: 5px; height: 5px; border-radius: 50%; background: #9333EA; flex-shrink: 0; }
</style>

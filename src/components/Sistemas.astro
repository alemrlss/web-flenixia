<section id="soluciones" class="sis-section overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <div class="sis-grid">

      <!-- Izquierda: Avatar -->
      <div class="reveal sis-avatar-col">
        <div class="sis-avatar-outer">

          <!-- CuadrÃ­cula de puntos esquina superior derecha -->
          <div class="sis-dot-grid sis-dot-grid-tr">
            {Array.from({length: 12}).map(() => <span></span>)}
          </div>

          <!-- CuadrÃ­cula de puntos esquina inferior izquierda -->
          <div class="sis-dot-grid sis-dot-grid-bl">
            {Array.from({length: 12}).map(() => <span></span>)}
          </div>

          <!-- Acento vertical izquierdo -->
          <div class="sis-accent-bar"></div>

          <!-- Imagen -->
          <div class="sis-avatar-wrap">
            <img
              src="/avatar.png"
              alt="Agente IA Flenixia"
              class="sis-avatar-img"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="sis-avatar-placeholder">
              <svg width="72" height="72" viewBox="0 0 72 72" fill="none">
                <circle cx="36" cy="24" r="12" fill="#7C3AED" fill-opacity="0.25" stroke="#C084FC" stroke-width="1.5"/>
                <rect x="16" y="42" width="40" height="24" rx="6" fill="#7C3AED" fill-opacity="0.2" stroke="#A78BFA" stroke-width="1.5"/>
              </svg>
            </div>
          </div>

        </div>
      </div>

      <!-- Derecha: contenido -->
      <div class="sis-content-col">

        <div class="reveal mb-4">
          <span class="sis-label">6 sistemas integrados</span>
        </div>

        <h2 class="reveal reveal-delay-1 sis-heading">
          Todo lo que tu negocio necesita,<br/>
          <span class="gradient-text">automatizado con IA.</span>
        </h2>

        <p class="reveal reveal-delay-2 sis-sub">
          Seis sistemas integrados para empresas que quieren crecer sin multiplicar plantilla.
        </p>

        <div class="reveal reveal-delay-3 sis-cards">
          {sistemas.map(s => (
            <div class="sis-card">
              <div class="sis-card-top">
                <div class="sis-icon">
                  <svg width="16" height="16" fill="none" stroke="#C084FC" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}/>
                  </svg>
                </div>
                <span class="sis-tag">{s.tag}</span>
              </div>
              <div class="sis-card-name">{s.name}</div>
              <p class="sis-card-desc">{s.desc}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .sis-section {
    background: #FFFFFF;
    padding: 6rem 0;
  }
  .sis-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 5rem;
    align-items: center;
  }
  @media (max-width: 1024px) {
    .sis-grid { grid-template-columns: 1fr; gap: 3rem; }
    .sis-avatar-col { display: flex; justify-content: center; }
  }

  /* â”€â”€ Avatar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .sis-avatar-col {
    display: flex; justify-content: center; align-items: center;
  }
  .sis-avatar-outer {
    position: relative;
    width: 100%; max-width: 340px;
  }
  .sis-avatar-wrap {
    width: 100%; overflow: hidden;
    background: linear-gradient(170deg, #0D0820 0%, #3B1D7A 45%, #1A1033 100%);
  }
  .sis-avatar-img {
    width: 100%; height: auto; display: block;
  }
  .sis-avatar-placeholder {
    display: none;
    flex-direction: column; align-items: center; justify-content: center;
    padding: 3rem; min-height: 400px;
  }

  /* CuadrÃ­cula de puntos */
  .sis-dot-grid {
    position: absolute;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 7px; pointer-events: none; z-index: 0;
  }
  .sis-dot-grid-tr { top: -18px; right: -18px; }
  .sis-dot-grid-bl { bottom: -18px; left: -18px; }
  .sis-dot-grid span {
    display: block; width: 4px; height: 4px; border-radius: 50%;
    background: #9333EA; opacity: 0.35;
  }
  .sis-dot-grid-tr span:nth-child(-n+4) { opacity: 0.6; }
  .sis-dot-grid-bl span:nth-last-child(-n+4) { opacity: 0.6; }

  /* Acento vertical izquierdo */
  .sis-accent-bar {
    position: absolute; left: -10px; top: 15%; bottom: 15%;
    width: 3px; border-radius: 99px;
    background: linear-gradient(to bottom, transparent, #9333EA, #C084FC, #9333EA, transparent);
    pointer-events: none; z-index: 0;
  }


  /* â”€â”€ Content â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
  .sis-label {
    display: inline-flex; align-items: center;
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #9333EA;
    background: #F3E8FF;
    border: 1px solid #DDD6FE;
    border-radius: 99px; padding: 0.3rem 0.9rem;
  }
  .sis-heading {
    font-family: 'Poppins', sans-serif; font-weight: 800;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.15; color: #1F1635;
    margin-bottom: 0.85rem;
  }
  .sis-sub {
    font-family: 'Poppins', sans-serif; font-size: 0.95rem;
    color: #64647A; margin-bottom: 2rem; line-height: 1.6;
  }

  /* Cards 3Ã—2 */
  .sis-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 700px) {
    .sis-cards { grid-template-columns: 1fr 1fr; }
  }
  .sis-card {
    background: #FAFAFA;
    border: 1px solid #EDE9FE;
    border-radius: 1rem; padding: 1.1rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .sis-card:hover {
    border-color: rgba(147,51,234,0.35);
    box-shadow: 0 8px 28px rgba(147,51,234,0.1);
    transform: translateY(-3px);
  }
  .sis-card-top {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.65rem;
  }
  .sis-icon {
    width: 34px; height: 34px;
    background: #F3E8FF; border: 1px solid #DDD6FE;
    border-radius: 0.6rem;
    display: flex; align-items: center; justify-content: center;
  }
  .sis-tag {
    font-family: 'Poppins', sans-serif; font-size: 0.6rem; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: #9333EA; background: #F3E8FF;
    border: 1px solid #DDD6FE;
    border-radius: 99px; padding: 0.15rem 0.5rem;
  }
  .sis-card-name {
    font-family: 'Poppins', sans-serif; font-weight: 700;
    font-size: 0.78rem; color: #1F1635; margin-bottom: 0.35rem; line-height: 1.3;
  }
  .sis-card-desc {
    font-family: 'Poppins', sans-serif; font-size: 0.7rem;
    color: #7C6DAB; line-height: 1.5;
  }
</style>


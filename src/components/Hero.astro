---
---
<section class="hero-section relative overflow-hidden pt-20">

  <div class="hero-bg absolute inset-0 z-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 pt-20 pb-24 lg:pt-28 lg:pb-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Izquierda: copy -->
      <div>
        <div class="reveal mb-6">
          <span class="hero-label">El sistema que no para de vender</span>
        </div>

        <h1 class="reveal reveal-delay-1 font-display font-extrabold leading-[1.05] mb-6"
            style="font-size:clamp(2.4rem,5vw,4rem); color:#FFFFFF">
          Tu sistema de <span class="hero-gradient-text">IA</span><br/>
          que no <span class="hero-gradient-text">descansa.</span>
        </h1>

        <p class="reveal reveal-delay-2 leading-relaxed mb-8"
           style="font-size:clamp(1rem,1.8vw,1.15rem); max-width:520px; color:rgba(255,255,255,0.72)">
          Combinamos CRM, automatizaciones, landings de alta conversión y agentes IA (chat y voz) para que cada lead reciba la respuesta correcta en el momento exacto — sin que tu equipo se queme.
        </p>

        <ul class="reveal reveal-delay-3 space-y-3 mb-10">
          {[
            'Responde leads en menos de 1 minuto, 24/7',
            'Agenda reuniones directo en tu calendario',
            'Llama, califica y hace seguimiento por voz',
            'Habla con el tono de tu marca, sin sonar a robot',
          ].map(b => (
            <li class="flex items-center gap-3 text-sm" style="color:rgba(255,255,255,0.82)">
              <span class="bullet-check flex-shrink-0">
                <svg width="13" height="13" fill="none" stroke="#C084FC" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
              </span>
              {b}
            </li>
          ))}
        </ul>

        <div class="reveal reveal-delay-4 flex flex-wrap gap-3 mb-10">
          <a href="#agenda" class="btn-primary">
            Agendar demo
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#como-funciona" class="btn-outline-white">Ver cómo funciona</a>
        </div>

        <div class="reveal reveal-delay-4">
          <p class="founder-quote">"Respondemos en menos de 24h"</p>
        </div>
      </div>

      <!-- Derecha: Chat IA simulación -->
      <div class="reveal reveal-delay-2 flex flex-col items-center gap-4">

        <div class="fl-chat-frame">

          <!-- Header -->
          <div class="fl-chat-header">
            <div class="fl-chat-avatar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" fill="white" fill-opacity="0.0"/>
                <circle cx="12" cy="12" r="4" fill="white"/>
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="fl-chat-header-info">
              <div class="fl-chat-name">Asistente Comercial IA</div>
              <div class="fl-chat-status">
                <span class="fl-online-dot"></span>
                En línea · Responde 24/7
              </div>
            </div>
          </div>

          <!-- Body con mensajes -->
          <div class="fl-chat-body" id="flChatBody">

            <div class="fl-chat-divider">Hoy</div>

            <div class="fl-msg fl-user" data-delay="500">
              <div class="fl-bubble">Hola, busco un CRM con agente de WhatsApp para mi inmobiliaria</div>
            </div>

            <div class="fl-msg fl-bot" data-delay="1600">
              <div class="fl-bubble">¡Hola! ✨ Perfecto. Nuestro stack incluye CRM + agente IA en WhatsApp y llamada. ¿Cuántos leads/mes manejas?</div>
            </div>

            <div class="fl-msg fl-user" data-delay="2800">
              <div class="fl-bubble">Unos 400 al mes, perdemos muchos</div>
            </div>

            <div class="fl-msg fl-bot" data-delay="4000">
              <div class="fl-bubble">Con esa volumetría te recuperamos ~25%. ¿Agendamos demo el jueves 16:00?</div>
            </div>

            <div class="fl-msg fl-user" data-delay="5200">
              <div class="fl-bubble">Sí, perfecto</div>
            </div>

            <div class="fl-msg fl-bot" data-delay="6200">
              <div class="fl-confirm">
                <div class="fl-confirm-icon">
                  <svg width="12" height="12" fill="none" stroke="#22C55E" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                </div>
                <div class="fl-confirm-text">
                  <span class="fl-confirm-title">Demo confirmada</span>
                  <span class="fl-confirm-sub">Jueves 16:00 · Estrategia IA · Flenixia</span>
                </div>
              </div>
            </div>

          </div>

          <!-- Powered by -->
          <div class="fl-powered">
            <span>Powered by</span>
            <svg width="9" height="9" viewBox="0 0 32 32" fill="none">
              <polygon points="16,2 28,9 28,23 16,30 4,23 4,9" fill="#A78BFA"/>
            </svg>
            <span class="fl-powered-brand">Flenixia</span>
          </div>

          <!-- Input -->
          <div class="fl-input-bar">
            <div class="fl-input-fake">Escribe un mensaje...</div>
            <button class="fl-send-btn" aria-label="Enviar">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Badges -->
        <div class="fl-badges">
          <div class="fl-badge fl-badge-purple">
            <svg width="13" height="13" fill="none" stroke="#A78BFA" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Responde en <strong>30s</strong></span>
          </div>
          <div class="fl-badge fl-badge-green">
            <svg width="13" height="13" fill="none" stroke="#34D399" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>
            </svg>
            <span><strong>+65%</strong> más conversión</span>
          </div>
        </div>

      </div>
    </div>
  </div>

</section>

<!-- Estilos del hero (scoped) -->
<style>
  .hero-section {
    background: #1A1033;
    min-height: 100vh;
    display: flex; flex-direction: column; justify-content: center;
  }
  .hero-bg {
    background:
      radial-gradient(ellipse at 70% 10%, rgba(147,51,234,0.45) 0%, transparent 55%),
      radial-gradient(ellipse at 20% 90%, rgba(124,58,237,0.25) 0%, transparent 50%),
      linear-gradient(180deg, #1A1033 0%, #0F0A22 100%);
  }
  .hero-label {
    display: inline-flex; align-items: center;
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.73rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #C084FC;
    background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 99px; padding: 0.3rem 0.9rem;
  }
  .hero-gradient-text {
    background: linear-gradient(135deg, #C084FC 0%, #A855F7 50%, #F0ABFC 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .bullet-check {
    width: 22px; height: 22px;
    background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .founder-quote {
    font-family: 'Inter', sans-serif; font-size: 0.78rem;
    color: rgba(255,255,255,0.45); font-style: italic;
  }
</style>

<!-- Estilos del chat (global para evitar scoping de Astro) -->
<style is:global>
  /* Frame */
  .fl-chat-frame {
    width: 100%; max-width: 400px;
    background: #100C20;
    border: 1px solid #3B1F6A;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 0 0 1px #1E0D40, 0 32px 80px rgba(0,0,0,0.7), 0 0 50px rgba(124,58,237,0.15);
  }

  /* Header */
  .fl-chat-header {
    background: #160F2C;
    border-bottom: 1px solid #2D1B55;
    padding: 0.9rem 1rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .fl-chat-avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #7C3AED, #9333EA);
    border: 2px solid #5B21B6;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 16px rgba(124,58,237,0.5);
  }
  .fl-chat-header-info { flex: 1; min-width: 0; }
  .fl-chat-name {
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.85rem; color: #F5F3FF;
    line-height: 1.2;
  }
  .fl-chat-status {
    display: flex; align-items: center; gap: 0.35rem;
    font-family: 'Inter', sans-serif; font-size: 0.68rem;
    color: #A78BFA; margin-top: 3px;
  }
  .fl-online-dot {
    width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
    background: #22C55E;
    box-shadow: 0 0 6px rgba(34,197,94,0.8);
    animation: fl-blink 2.5s ease-in-out infinite;
  }
  @keyframes fl-blink { 0%,100%{opacity:1;} 50%{opacity:.4;} }

  /* Body */
  .fl-chat-body {
    background: #100C20;
    padding: 0.85rem 0.9rem;
    display: flex; flex-direction: column; gap: 0.5rem;
    overflow: visible;
  }
  .fl-chat-divider {
    text-align: center;
    font-family: 'Inter', sans-serif; font-size: 0.63rem;
    color: #6B5FA6; margin-bottom: 0.1rem;
  }

  /* Messages — hidden by default, JS reveals them */
  .fl-msg {
    display: flex; flex-direction: column; gap: 3px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .fl-msg.fl-show {
    opacity: 1;
    transform: translateY(0);
  }
  .fl-user { align-items: flex-end; }
  .fl-bot  { align-items: flex-start; }

  /* Bubbles */
  .fl-bubble {
    max-width: 84%;
    padding: 0.65rem 1rem;
    border-radius: 1.1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .fl-user .fl-bubble {
    background: #7C3AED;
    color: #FFFFFF;
    border-bottom-right-radius: 0.2rem;
  }
  .fl-bot .fl-bubble {
    background: #231B4A;
    border: 1px solid #3D2B7A;
    color: #EDE9FE;
    border-bottom-left-radius: 0.2rem;
  }

  /* Timestamps */
  .fl-ts {
    font-family: 'Inter', sans-serif; font-size: 0.6rem;
    color: #7C6DAB; padding: 0 0.3rem;
  }

  /* Typing */
  .fl-typing {
    display: flex; align-items: center; gap: 5px;
    padding: 0.65rem 1rem;
    background: #231B4A;
    border: 1px solid #3D2B7A;
    border-radius: 1.1rem; border-bottom-left-radius: 0.2rem;
    width: fit-content;
  }
  .fl-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #A78BFA;
    animation: fl-bounce 1.1s ease-in-out infinite;
  }
  .fl-dot:nth-child(2) { animation-delay: 0.18s; }
  .fl-dot:nth-child(3) { animation-delay: 0.36s; }
  @keyframes fl-bounce { 0%,80%,100%{transform:translateY(0);} 40%{transform:translateY(-5px);} }

  /* Confirm card */
  .fl-confirm {
    display: inline-flex; align-items: center; gap: 0.7rem;
    padding: 0.7rem 1rem;
    background: #052E16;
    border: 1px solid #166534;
    border-radius: 0.9rem;
    max-width: 84%;
  }
  .fl-confirm-icon {
    width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
    background: #14532D; border: 1px solid #166534;
    display: flex; align-items: center; justify-content: center;
  }
  .fl-confirm-text { display: flex; flex-direction: column; gap: 2px; }
  .fl-confirm-title {
    font-family: 'Poppins', sans-serif; font-size: 0.8rem; font-weight: 700;
    color: #4ADE80; line-height: 1.2;
  }
  .fl-confirm-sub {
    font-family: 'Inter', sans-serif; font-size: 0.68rem;
    color: #86EFAC; line-height: 1.3;
  }

  /* Powered by */
  .fl-powered {
    display: flex; align-items: center; justify-content: center; gap: 0.35rem;
    padding: 0.45rem;
    border-top: 1px solid #1E1640;
    font-family: 'Inter', sans-serif; font-size: 0.6rem;
    color: #6B5FA6;
  }
  .fl-powered-brand { color: #C4B5FD; font-weight: 600; }

  /* Input */
  .fl-input-bar {
    background: #160F2C;
    border-top: 1px solid #2D1B55;
    padding: 0.7rem 0.9rem;
    display: flex; align-items: center; gap: 0.55rem;
  }
  .fl-input-fake {
    flex: 1; font-family: 'Inter', sans-serif; font-size: 0.76rem;
    color: #6B5FA6;
    background: #1E1640;
    border: 1px solid #2D1B69;
    border-radius: 99px; padding: 0.5rem 1rem;
  }
  .fl-send-btn {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #7C3AED, #9333EA);
    border: none; cursor: default;
    display: flex; align-items: center; justify-content: center;
    color: #fff; box-shadow: 0 0 14px rgba(124,58,237,0.5);
  }

  /* Badges */
  .fl-badges {
    display: flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center;
  }
  .fl-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.42rem 0.9rem;
    border-radius: 99px;
    font-family: 'Inter', sans-serif; font-size: 0.75rem;
  }
  .fl-badge-purple {
    background: #160F2C; border: 1px solid #3B1F6A;
    color: #C4B5FD;
  }
  .fl-badge-purple strong { color: #E9D5FF; font-weight: 700; }
  .fl-badge-green {
    background: #052E16; border: 1px solid #166534;
    color: #86EFAC;
  }
  .fl-badge-green strong { color: #4ADE80; font-weight: 700; }
</style>

<script>
  function runChat() {
    const body = document.getElementById('flChatBody');
    if (!body) return;

    const msgs = Array.from(body.querySelectorAll('.fl-msg'));
    msgs.forEach(m => m.classList.remove('fl-show'));

    msgs.forEach(m => {
      const delay = parseInt(m.dataset.delay || '0', 10);
      setTimeout(() => m.classList.add('fl-show'), delay);
    });

    const lastDelay = Math.max(...msgs.map(m => parseInt(m.dataset.delay || '0', 10)));
    setTimeout(runChat, lastDelay + 4000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runChat);
  } else {
    runChat();
  }
</script>

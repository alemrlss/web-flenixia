---
---
<section class="hero-section relative overflow-hidden pt-20">

  <!-- Fondo degradado lila oscuro -->
  <div class="hero-bg absolute inset-0 z-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 pt-20 pb-24 lg:pt-28 lg:pb-32">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Izquierda: copy -->
      <div>
        <div class="reveal mb-6">
          <span class="hero-label">El sistema que no para de vender</span>
        </div>

        <h1 class="reveal reveal-delay-1 font-display font-extrabold leading-[1.05] mb-6"
            style="font-size:clamp(2.4rem,5vw,4rem); color:#FFFFFF">
          Tu sistema de <span class="hero-gradient-text">IA</span><br/>
          que no <span class="hero-gradient-text">descansa.</span>
        </h1>

        <p class="reveal reveal-delay-2 leading-relaxed mb-8"
           style="font-size:clamp(1rem,1.8vw,1.15rem); max-width:520px; color:rgba(255,255,255,0.72)">
          Combinamos CRM, automatizaciones, landings de alta conversión y agentes IA (chat y voz) para que cada lead reciba la respuesta correcta en el momento exacto — sin que tu equipo se queme.
        </p>

        <ul class="reveal reveal-delay-3 space-y-3 mb-10">
          {[
            'Responde leads en menos de 1 minuto, 24/7',
            'Agenda reuniones directo en tu calendario',
            'Llama, califica y hace seguimiento por voz',
            'Habla con el tono de tu marca, sin sonar a robot',
          ].map(b => (
            <li class="flex items-center gap-3 text-sm" style="color:rgba(255,255,255,0.82)">
              <span class="bullet-check flex-shrink-0">
                <svg width="13" height="13" fill="none" stroke="#C084FC" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
              </span>
              {b}
            </li>
          ))}
        </ul>

        <div class="reveal reveal-delay-4 flex flex-wrap gap-3 mb-10">
          <a href="#agenda" class="btn-primary">
            Agendar demo
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#como-funciona" class="btn-outline-white">Ver cómo funciona</a>
        </div>

        <!-- Social proof -->
        <div class="reveal reveal-delay-4">
          <p class="founder-quote">"Respondemos en menos de 24h"</p>
        </div>
      </div>

      <!-- Derecha: Plenixia Core mockup -->
      <div class="reveal reveal-delay-2 flex items-center justify-center">
        <div class="core-frame">
          <div class="core-chrome">
            <span class="core-dot" style="background:#FF5F57"></span>
            <span class="core-dot" style="background:#FEBC2E"></span>
            <span class="core-dot" style="background:#28C840"></span>
            <div class="core-url">plenixia.com / core</div>
          </div>
          <div class="core-canvas">
            <!-- Centro -->
            <div class="core-center">
              <div class="core-ring"></div>
              <div class="core-inner">
                <svg width="20" height="20" viewBox="0 0 32 32" fill="none">
                  <polygon points="16,2 28,9 28,23 16,30 4,23 4,9" fill="#9333EA"/>
                  <text x="16" y="22" text-anchor="middle" font-family="Poppins,sans-serif" font-weight="700" font-size="13" fill="white">F</text>
                </svg>
                <span class="core-label">CORE</span>
              </div>
            </div>
            <!-- Nodos -->
            <div class="core-node" style="top:5%;left:50%;transform:translateX(-50%)">
              <div class="node-icon"><svg width="12" height="12" fill="none" stroke="#9333EA" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25"/></svg></div>
              <span>CRM</span>
            </div>
            <div class="core-node" style="top:22%;right:4%">
              <div class="node-icon"><svg width="12" height="12" fill="none" stroke="#9333EA" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3"/></svg></div>
              <span>Landings</span>
            </div>
            <div class="core-node" style="bottom:22%;right:4%">
              <div class="node-icon"><svg width="12" height="12" fill="none" stroke="#9333EA" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg></div>
              <span>Email</span>
            </div>
            <div class="core-node" style="bottom:5%;left:50%;transform:translateX(-50%)">
              <div class="node-icon"><svg width="12" height="12" fill="none" stroke="#9333EA" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/></svg></div>
              <span>Chat IA</span>
            </div>
            <div class="core-node" style="bottom:22%;left:4%">
              <div class="node-icon"><svg width="12" height="12" fill="none" stroke="#9333EA" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg></div>
              <span>Voz IA</span>
            </div>
            <div class="core-node" style="top:22%;left:4%">
              <div class="node-icon"><svg width="12" height="12" fill="none" stroke="#9333EA" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg></div>
              <span>Workflows</span>
            </div>
            <!-- Feed -->
            <div class="core-feed">
              <div class="feed-item"><span class="feed-dot live"></span><span>Lead respondido en 18s</span></div>
              <div class="feed-item"><span class="feed-dot"></span><span>Cita agendada · Juan M.</span></div>
              <div class="feed-item"><span class="feed-dot"></span><span>Flujo activado · eCommerce</span></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

</section>

<style>
  .hero-section {
    background: #1A1033;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-bg {
    background:
      radial-gradient(ellipse at 70% 10%, rgba(147,51,234,0.45) 0%, transparent 55%),
      radial-gradient(ellipse at 20% 90%, rgba(124,58,237,0.25) 0%, transparent 50%),
      linear-gradient(180deg, #1A1033 0%, #0F0A22 100%);
  }
  .hero-label {
    display: inline-flex; align-items: center;
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.73rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #C084FC;
    background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 99px; padding: 0.3rem 0.9rem;
  }
  .hero-gradient-text {
    background: linear-gradient(135deg, #C084FC 0%, #A855F7 50%, #F0ABFC 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .bullet-check {
    width: 22px; height: 22px;
    background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }

  /* Mockup */
  .core-frame {
    width: 100%; max-width: 460px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(147,51,234,0.25);
    border-radius: 1rem; overflow: hidden;
    box-shadow: 0 0 0 1px rgba(147,51,234,0.1), 0 32px 80px rgba(0,0,0,0.5);
  }
  .core-chrome {
    background: rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(147,51,234,0.15);
    padding: 0.55rem 1rem;
    display: flex; align-items: center; gap: 0.4rem;
  }
  .core-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .core-url {
    flex: 1; margin-left: 0.5rem;
    background: rgba(255,255,255,0.04); border-radius: 4px;
    padding: 0.2rem 0.75rem; font-size: 0.65rem;
    color: rgba(255,255,255,0.25); font-family: 'Inter', monospace;
  }
  .core-canvas {
    position: relative; height: 320px;
    display: flex; align-items: center; justify-content: center;
    padding: 1rem;
  }
  .core-center { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); z-index: 3; }
  .core-ring {
    position: absolute; inset: -12px; border-radius: 50%;
    border: 1px solid rgba(147,51,234,0.4);
    animation: ring-pulse 3s ease-in-out infinite;
  }
  @keyframes ring-pulse { 0%,100% { transform:scale(1);opacity:.5; } 50% { transform:scale(1.15);opacity:1; } }
  .core-inner {
    width: 64px; height: 64px;
    background: rgba(147,51,234,0.15);
    border: 1.5px solid rgba(147,51,234,0.5);
    border-radius: 50%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 2px; box-shadow: 0 0 24px rgba(147,51,234,0.35);
  }
  .core-label {
    font-family: 'Poppins', sans-serif; font-weight: 700;
    font-size: 0.5rem; letter-spacing: 0.1em; color: #C084FC;
  }
  .core-node {
    position: absolute;
    display: flex; flex-direction: column; align-items: center; gap: 4px; z-index: 3;
  }
  .node-icon {
    width: 34px; height: 34px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(147,51,234,0.3);
    border-radius: 0.5rem;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 12px rgba(147,51,234,0.15);
  }
  .core-node span:last-child {
    font-family: 'Poppins', sans-serif; font-size: 0.55rem; font-weight: 600;
    color: rgba(255,255,255,0.45); white-space: nowrap;
  }
  .core-feed {
    position: absolute; bottom: 0.75rem; left: 0.75rem; right: 0.75rem; z-index: 4;
    background: rgba(10,10,15,0.7); border: 1px solid rgba(147,51,234,0.2);
    border-radius: 0.5rem; padding: 0.5rem 0.75rem;
  }
  .feed-item {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: 'Inter', sans-serif; font-size: 0.62rem;
    color: rgba(255,255,255,0.4); padding: 0.18rem 0;
  }
  .feed-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.15); flex-shrink: 0; }
  .feed-dot.live { background: #A855F7; animation: dot-pulse 2s ease-in-out infinite; }
  @keyframes dot-pulse { 0%,100% { opacity:1; } 50% { opacity:.4; } }

  /* Founder strip */
  .founder-strip {
    display: flex; align-items: center; gap: 0.85rem;
    flex-wrap: wrap;
  }
  .founder-avatar {
    width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #9333EA, #C084FC);
    border: 2px solid rgba(192,132,252,0.4);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    box-shadow: 0 0 0 3px rgba(147,51,234,0.2);
    position: relative;
  }
  .founder-initials {
    font-family: 'Poppins', sans-serif; font-weight: 700;
    font-size: 1.1rem; color: #fff;
  }
  .founder-name {
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.82rem; color: rgba(255,255,255,0.9);
    line-height: 1.2;
  }
  .founder-role {
    font-family: 'Inter', sans-serif; font-size: 0.72rem;
    color: rgba(255,255,255,0.4); margin-top: 1px;
  }
.founder-quote {
    font-family: 'Inter', sans-serif; font-size: 0.78rem;
    color: rgba(255,255,255,0.45); font-style: italic;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CalculadoraWidget from '../components/CalculadoraWidget.astro';
---

<Layout
  title="Calculadora de Inversión en IA — Flenixia"
  description="Elige el servicio que necesita tu negocio y obtén al instante una estimación de inversión, con o sin IVA."
>
  <Navbar />

  <!-- Mini-hero -->
  <section class="calc-hero relative overflow-hidden pt-32 pb-16">
    <div class="calc-hero-bg absolute inset-0 z-0"></div>
    <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-10 text-center">
      <div class="reveal mb-5 flex justify-center">
        <span class="dark-label">Estimación instantánea</span>
      </div>
      <h1 class="reveal reveal-delay-1 font-display font-extrabold text-white leading-tight mb-5"
          style="font-size:clamp(2.2rem,4.5vw,3.2rem)">
        Calcula tu inversión<br/>
        <span class="gradient-text">en IA.</span>
      </h1>
      <p class="reveal reveal-delay-2 text-lg leading-relaxed mx-auto" style="max-width:34rem; color:rgba(255,255,255,0.65)">
        Elige el servicio que tu negocio necesita y mira una estimación al instante — con o sin IVA. Sin formularios, sin esperas.
      </p>
    </div>
  </section>

  <!-- Calculadora -->
  <section class="py-20" style="background:#0F0A22">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <CalculadoraWidget />

      <p class="calc-disclaimer reveal reveal-delay-2">
        Esta estimación es orientativa y depende de la volumetría y el alcance real de tu negocio.
        El precio final se define en tu <strong>diagnóstico inicial gratuito</strong>, donde analizamos
        tu caso concreto y te entregamos una propuesta cerrada — sin compromiso de contratación.
      </p>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-20 text-center" style="background:#FAF8FF; border-top:1px solid #EDE9FE">
    <div class="max-w-2xl mx-auto px-6 lg:px-10">
      <h2 class="reveal font-display font-extrabold leading-tight mb-4"
          style="font-size:clamp(1.6rem,3.2vw,2.2rem); color:#1F1635">
        ¿Hablamos de tu caso concreto?
      </h2>
      <p class="reveal reveal-delay-1 mb-8" style="color:#64647A; font-size:1.05rem">
        Agenda un diagnóstico gratuito de 30 minutos. Salís con un plan de acción y una propuesta a medida — sin coste ni compromiso.
      </p>
      <a href="/#agenda" class="reveal reveal-delay-2 btn-primary">
        Agendar diagnóstico gratuito
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .calc-hero { background: #1A1033; }
  .calc-hero-bg {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(147,51,234,0.4) 0%, transparent 55%),
      radial-gradient(ellipse at 80% 100%, rgba(124,58,237,0.2) 0%, transparent 50%),
      linear-gradient(180deg, #1A1033 0%, #0F0A22 100%);
  }
  .dark-label {
    display: inline-flex; align-items: center;
    font-family: 'Poppins', sans-serif; font-weight: 600;
    font-size: 0.73rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: #C084FC; background: rgba(192,132,252,0.12);
    border: 1px solid rgba(192,132,252,0.25); border-radius: 99px; padding: 0.3rem 0.9rem;
  }
  .calc-disclaimer {
    max-width: 42rem; margin: 2.5rem auto 0;
    text-align: center; font-family: 'Inter', sans-serif;
    font-size: 0.85rem; line-height: 1.7;
    color: rgba(255,255,255,0.4);
  }
  .calc-disclaimer strong { color: rgba(255,255,255,0.65); }
</style>

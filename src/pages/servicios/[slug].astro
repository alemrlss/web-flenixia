---
import Layout       from '../../layouts/Layout.astro';
import Navbar       from '../../components/Navbar.astro';
import Footer       from '../../components/Footer.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import { servicios } from '../../data/servicios';

export function getStaticPaths() {
  return servicios.map(s => ({ params: { slug: s.slug }, props: { servicio: s } }));
}

const { servicio: s } = Astro.props;
const isDark     = s.variant === 'dark';
const isSplit    = s.variant === 'split';
const isEditorial = s.variant === 'editorial';
const ac = s.accent;
---

<Layout title={`${s.name} — Flenixia`} description={s.desc}>
  <Navbar />

  {/* ════════════════════════════════════════════════════
      VARIANT: DARK — Agentes IA, Automatizaciones, AO
  ════════════════════════════════════════════════════ */}
  {isDark && (
    <div class="srv-dark">

      <!-- Hero dark: pantalla completa, stats gigantes flotando -->
      <section class="sd-hero">
        <img src={s.heroImg} alt={s.name} class="sd-hero-bg"/>
        <div class="sd-hero-overlay"></div>
        <div class="sd-hero-content max-w-6xl mx-auto px-6 lg:px-10">
          <div class="sd-hero-left">
            <h1 class="sd-title">{s.name}</h1>
            <p class="sd-tagline">{s.tagline}</p>
            <p class="sd-desc">{s.desc}</p>
            <div class="sd-ctas">
              <a href="#agenda" class="btn-primary">Quiero empezar →</a>
              <a href="#incluye" class="sd-ghost">Ver qué incluye</a>
            </div>
          </div>
          <div class="sd-hero-stats">
            {s.resultados.map(r => (
              <div class="sd-stat">
                <span class="sd-stat-num" style={`color:${ac}`}>{r.metric}</span>
                <span class="sd-stat-label">{r.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Qué incluye: cards dark con borde de color -->
      <section id="incluye" class="sd-section-dark">
        <div class="max-w-6xl mx-auto px-6 lg:px-10">
          <h2 class="sd-section-title">Qué <span style={`color:${ac}`}>incluye</span></h2>
          <div class="sd-incluye-grid">
            {s.incluye.map((item, i) => (
              <div class="sd-incluye-card" style={i === 0 ? `border-color:${ac}40;` : ''}>
                <div class="sd-incluye-num" style={`color:${ac}`}>{String(i+1).padStart(2,'0')}</div>
                <h3 class="sd-incluye-title">{item.title}</h3>
                <p class="sd-incluye-desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Proceso: línea de tiempo horizontal -->
      <section class="sd-section-darker">
        <div class="max-w-6xl mx-auto px-6 lg:px-10">
          <h2 class="sd-section-title">Cómo <span style={`color:${ac}`}>trabajamos</span></h2>
          <div class="sd-timeline">
            {s.proceso.map((step, i) => (
              <div class="sd-timeline-step">
                <div class="sd-timeline-dot" style={`background:${ac};box-shadow:0 0 16px ${ac}80`}></div>
                {i < s.proceso.length - 1 && <div class="sd-timeline-line" style={`background:linear-gradient(90deg,${ac}60,transparent)`}></div>}
                <h3 class="sd-timeline-title">{step.title}</h3>
                <p class="sd-timeline-desc">{step.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Para quién: dark cards + CTA box -->
      <section class="sd-section-dark">
        <div class="max-w-6xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-12 items-start">
          <div>
            <h2 class="sd-section-title">¿Para <span style={`color:${ac}`}>quién</span>?</h2>
            <div class="sd-paraquien">
              {s.paraQuien.map(item => (
                <div class="sd-pq-item">
                  <span class="sd-pq-dot" style={`background:${ac}`}></span>
                  {item}
                </div>
              ))}
            </div>
          </div>
          <div class="sd-cta-box" style={`border-color:${ac}40`}>
            <p class="sd-cta-tag" style={`color:${ac}`}>Sin compromiso</p>
            <h3 class="sd-cta-title">{s.idealPara}</h3>
            <p class="sd-cta-sub">Primera consulta gratuita. Te decimos exactamente lo que podemos hacer por tu negocio.</p>
            <a href="#agenda" class="btn-primary w-full justify-center">Hablar con un experto →</a>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      {s.faq.length > 0 && (
        <section class="sd-section-darker">
          <div class="max-w-3xl mx-auto px-6 lg:px-10">
            <h2 class="sd-section-title text-center">Preguntas <span style={`color:${ac}`}>frecuentes</span></h2>
            <div class="space-y-3">
              {s.faq.map(faq => (
                <div class="faq-srv-item sd-faq-item">
                  <button class="faq-srv-btn w-full flex items-center justify-between gap-4 px-6 py-5 text-left cursor-pointer">
                    <span class="font-display font-semibold text-sm" style="color:#F0F0FF">{faq.q}</span>
                    <svg class="faq-srv-icon flex-shrink-0 w-5 h-5 transition-transform duration-300" fill="none" stroke={ac} stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                  </button>
                  <div class="faq-srv-answer max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out">
                    <p class="px-6 pb-5 pt-2 text-sm leading-relaxed" style="color:rgba(240,240,255,0.55);border-top:1px solid rgba(192,132,252,0.15)">{faq.a}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Agenda -->
      <section id="agenda" class="sd-section-dark py-24">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
          <h2 class="sd-section-title text-center mb-10">Agenda tu <span style={`color:${ac}`}>diagnóstico</span></h2>
          <BookingWidget />
        </div>
      </section>
    </div>
  )}

  {/* ════════════════════════════════════════════════════
      VARIANT: SPLIT — Desarrollo Web, A Medida, SEO
  ════════════════════════════════════════════════════ */}
  {isSplit && (
    <div class="srv-split">

      <!-- Hero: texto izquierda, imagen derecha -->
      <section class="ss-hero">
        <div class="max-w-7xl mx-auto px-6 lg:px-10">
          <div class="ss-hero-grid">
            <div class="ss-hero-left">
              <div class="ss-tag" style={`background:${ac}18;color:${ac};border-color:${ac}40`}>{s.name}</div>
              <h1 class="ss-title">{s.tagline}</h1>
              <p class="ss-desc">{s.desc}</p>
              <div class="ss-stats">
                {s.resultados.map(r => (
                  <div class="ss-stat">
                    <span class="ss-stat-num" style={`color:${ac}`}>{r.metric}</span>
                    <span class="ss-stat-label">{r.label}</span>
                  </div>
                ))}
              </div>
              <div class="ss-ctas">
                <a href="#agenda" class="ss-cta-main" style={`background:${ac}`}>Empezar ahora →</a>
                <a href="#incluye" class="ss-cta-ghost">Ver detalles</a>
              </div>
            </div>
            <div class="ss-hero-right">
              <div class="ss-img-frame">
                <img src={s.heroImg} alt={s.name} class="ss-img"/>
                <div class="ss-img-pill" style={`background:${ac}`}>
                  <svg width="12" height="12" fill="none" stroke="white" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                  Resultados garantizados
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Incluye: 2 columnas con icono de check de color -->
      <section id="incluye" class="ss-section-white">
        <div class="max-w-6xl mx-auto px-6 lg:px-10">
          <div class="ss-section-header">
            <div class="ss-section-line" style={`background:${ac}`}></div>
            <h2 class="ss-section-title">Todo lo que incluye</h2>
          </div>
          <div class="ss-incluye-grid">
            {s.incluye.map(item => (
              <div class="ss-incluye-card">
                <div class="ss-check" style={`background:${ac}15;border-color:${ac}40`}>
                  <svg width="12" height="12" fill="none" stroke={ac} stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                </div>
                <div>
                  <h3 class="ss-incluye-title">{item.title}</h3>
                  <p class="ss-incluye-desc">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Proceso: cards numeradas con acento -->
      <section class="ss-section-gray">
        <div class="max-w-6xl mx-auto px-6 lg:px-10">
          <div class="ss-section-header">
            <div class="ss-section-line" style={`background:${ac}`}></div>
            <h2 class="ss-section-title">Cómo trabajamos</h2>
          </div>
          <div class="ss-proceso-grid">
            {s.proceso.map((step, i) => (
              <div class="ss-paso-card">
                <div class="ss-paso-num" style={`color:${ac};border-color:${ac}30`}>{String(i+1).padStart(2,'0')}</div>
                <h3 class="ss-paso-title">{step.title}</h3>
                <p class="ss-paso-desc">{step.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Para quién + CTA -->
      <section class="ss-section-white">
        <div class="max-w-6xl mx-auto px-6 lg:px-10 grid lg:grid-cols-5 gap-10 items-start">
          <div class="lg:col-span-3">
            <div class="ss-section-header">
              <div class="ss-section-line" style={`background:${ac}`}></div>
              <h2 class="ss-section-title">¿Para quién es?</h2>
            </div>
            <div class="ss-pq-list">
              {s.paraQuien.map(item => (
                <div class="ss-pq-item">
                  <div class="ss-pq-bullet" style={`background:${ac}`}></div>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="lg:col-span-2 ss-cta-card" style={`border-top:4px solid ${ac}`}>
            <p class="ss-cta-eyebrow" style={`color:${ac}`}>Empieza hoy</p>
            <h3 class="ss-cta-title">{s.idealPara}</h3>
            <p class="ss-cta-sub">Primera llamada sin coste. Sin compromisos.</p>
            <a href="#agenda" class="ss-cta-btn" style={`background:${ac}`}>Agendar llamada →</a>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      {s.faq.length > 0 && (
        <section class="ss-section-gray">
          <div class="max-w-3xl mx-auto px-6 lg:px-10">
            <div class="ss-section-header">
              <div class="ss-section-line" style={`background:${ac}`}></div>
              <h2 class="ss-section-title">Preguntas frecuentes</h2>
            </div>
            <div class="space-y-3">
              {s.faq.map(faq => (
                <div class="faq-srv-item">
                  <button class="faq-srv-btn w-full flex items-center justify-between gap-4 px-6 py-5 text-left cursor-pointer">
                    <span class="font-display font-semibold text-sm" style="color:#1F1635">{faq.q}</span>
                    <svg class="faq-srv-icon flex-shrink-0 w-5 h-5 transition-transform duration-300" fill="none" stroke={ac} stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                  </button>
                  <div class="faq-srv-answer max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out">
                    <p class="px-6 pb-5 pt-2 text-sm leading-relaxed" style="color:#64647A;border-top:1px solid #EDE9FE">{faq.a}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Agenda -->
      <section id="agenda" class="ss-section-agenda">
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
          <h2 class="text-center font-display font-extrabold text-white mb-2" style="font-size:clamp(1.8rem,3.5vw,2.6rem)">
            ¿Listo para empezar?
          </h2>
          <p class="text-center mb-10" style="color:rgba(255,255,255,0.5)">Sin compromiso. Respondemos en menos de 24h.</p>
          <BookingWidget />
        </div>
      </section>
    </div>
  )}

  {/* ════════════════════════════════════════════════════
      VARIANT: EDITORIAL — RRSS, Consultoría, CRM
  ════════════════════════════════════════════════════ */}
  {isEditorial && (
    <div class="srv-editorial">

      <!-- Hero editorial: tipografía gigante, imagen de fondo suave -->
      <section class="se-hero">
        <div class="se-hero-bg-img" style={`background-image:url(${s.heroImg})`}></div>
        <div class="se-hero-overlay"></div>
        <div class="max-w-6xl mx-auto px-6 lg:px-10 relative z-10 pt-36 pb-24">
          <div class="se-hero-tag" style={`background:${ac};color:#fff`}>{s.name}</div>
          <h1 class="se-hero-title">{s.tagline}</h1>
          <div class="se-hero-bottom">
            <p class="se-hero-desc">{s.desc}</p>
            <div class="se-hero-actions">
              <a href="#agenda" class="se-cta-main" style={`background:${ac}`}>Empezar →</a>
              <a href="#incluye" class="se-ghost">Ver más</a>
            </div>
          </div>
        </div>
        <!-- Banda de métricas -->
        <div class="se-metrics-band">
          {s.resultados.map(r => (
            <div class="se-metric">
              <span class="se-metric-num" style={`color:${ac}`}>{r.metric}</span>
              <span class="se-metric-label">{r.label}</span>
              <span class="se-metric-desc">{r.desc}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Incluye: lista editorial con números grandes -->
      <section id="incluye" class="se-section-white">
        <div class="max-w-6xl mx-auto px-6 lg:px-10">
          <h2 class="se-section-title">Lo que incluye</h2>
          <div class="se-incluye-list">
            {s.incluye.map((item, i) => (
              <div class="se-incluye-row">
                <span class="se-incluye-idx" style={`color:${ac}`}>{String(i+1).padStart(2,'0')}</span>
                <div class="se-incluye-body">
                  <h3 class="se-incluye-name">{item.title}</h3>
                  <p class="se-incluye-desc">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Proceso + Para quién: dos columnas blancas -->
      <section class="se-section-offwhite">
        <div class="max-w-6xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-16">
          <div>
            <h2 class="se-section-title">Cómo funciona</h2>
            <div class="se-proceso-list">
              {s.proceso.map((step, i) => (
                <div class="se-paso">
                  <div class="se-paso-dot" style={`border-color:${ac};background:${ac}20`}>
                    <div class="se-paso-dot-inner" style={`background:${ac}`}></div>
                  </div>
                  <div class="se-paso-body">
                    <h3 class="se-paso-title">{step.title}</h3>
                    <p class="se-paso-desc">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div>
            <h2 class="se-section-title">¿Para quién?</h2>
            <div class="se-pq-list">
              {s.paraQuien.map(item => (
                <div class="se-pq-item">
                  <div class="se-pq-arrow" style={`color:${ac}`}>→</div>
                  <span>{item}</span>
                </div>
              ))}
            </div>
            <div class="se-cta-inline" style={`border-left:4px solid ${ac}`}>
              <p class="se-cta-inline-text">{s.idealPara}</p>
              <a href="#agenda" class="se-cta-link" style={`color:${ac}`}>Agendar diagnóstico →</a>
            </div>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      {s.faq.length > 0 && (
        <section class="se-section-white">
          <div class="max-w-3xl mx-auto px-6 lg:px-10">
            <h2 class="se-section-title">Preguntas frecuentes</h2>
            <div class="space-y-3">
              {s.faq.map(faq => (
                <div class="faq-srv-item">
                  <button class="faq-srv-btn w-full flex items-center justify-between gap-4 px-6 py-5 text-left cursor-pointer">
                    <span class="font-display font-semibold text-sm" style="color:#1F1635">{faq.q}</span>
                    <svg class="faq-srv-icon flex-shrink-0 w-5 h-5 transition-transform duration-300" fill="none" stroke={ac} stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                    </svg>
                  </button>
                  <div class="faq-srv-answer max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out">
                    <p class="px-6 pb-5 pt-2 text-sm leading-relaxed" style="color:#64647A;border-top:1px solid #EDE9FE">{faq.a}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Agenda -->
      <section id="agenda" class="se-section-agenda" style={`background:linear-gradient(135deg,#1A1033 0%,${ac}40 100%)`}>
        <div class="max-w-5xl mx-auto px-6 lg:px-10">
          <h2 class="text-center font-display font-extrabold text-white mb-2" style="font-size:clamp(1.8rem,3.5vw,2.6rem)">
            ¿Hablamos?
          </h2>
          <p class="text-center mb-10" style="color:rgba(255,255,255,0.5)">Primera consulta gratuita y sin compromiso.</p>
          <BookingWidget />
        </div>
      </section>
    </div>
  )}

  <Footer />
</Layout>

<style>
  /* ═══════════ DARK ═══════════ */
  .sd-hero {
    position: relative; min-height: 100vh;
    display: flex; align-items: center;
    background: #0A0614; padding: 7rem 0 4rem;
  }
  .sd-hero-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0.08;
  }
  .sd-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to right, #0A0614 50%, transparent 100%);
  }
  .sd-hero-content {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 4rem; align-items: center;
    width: 100%;
  }
  @media(max-width:768px){ .sd-hero-content { grid-template-columns:1fr; } }
  .sd-title {
    font-family:'Poppins',sans-serif; font-weight:900;
    font-size:clamp(2.5rem,6vw,4.5rem); color:#fff;
    line-height:1; margin-bottom:1rem;
  }
  .sd-tagline {
    font-family:'Inter',sans-serif; font-size:1.15rem;
    color:rgba(255,255,255,0.55); margin-bottom:1.5rem;
  }
  .sd-desc {
    font-family:'Inter',sans-serif; font-size:0.9rem;
    color:rgba(255,255,255,0.4); line-height:1.7; margin-bottom:2rem;
  }
  .sd-ctas { display:flex; gap:0.75rem; flex-wrap:wrap; }
  .sd-ghost {
    display:inline-flex; align-items:center;
    padding:0.65rem 1.4rem;
    border:1px solid rgba(255,255,255,0.15); border-radius:99px;
    font-family:'Poppins',sans-serif; font-size:0.85rem; font-weight:600;
    color:rgba(255,255,255,0.6); text-decoration:none;
    transition:border-color 0.2s, color 0.2s;
  }
  .sd-ghost:hover { border-color:rgba(255,255,255,0.4); color:#fff; }
  .sd-hero-stats {
    display:flex; flex-direction:column; gap:1.5rem;
    padding:2rem; border:1px solid rgba(255,255,255,0.08);
    border-radius:1.25rem; background:rgba(255,255,255,0.03);
    backdrop-filter:blur(10px);
  }
  .sd-stat { display:flex; flex-direction:column; }
  .sd-stat-num {
    font-family:'Poppins',sans-serif; font-weight:900;
    font-size:2.5rem; line-height:1;
  }
  .sd-stat-label {
    font-family:'Inter',sans-serif; font-size:0.75rem;
    color:rgba(255,255,255,0.4); margin-top:2px; text-transform:uppercase; letter-spacing:0.06em;
  }
  .sd-section-dark { background:#0D0920; padding:5rem 0; }
  .sd-section-darker { background:#0A0614; padding:5rem 0; }
  .sd-section-title {
    font-family:'Poppins',sans-serif; font-weight:800;
    font-size:clamp(1.6rem,3vw,2.2rem); color:#F0F0FF;
    margin-bottom:2.5rem;
  }
  .sd-incluye-grid {
    display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:1rem;
  }
  .sd-incluye-card {
    background:rgba(255,255,255,0.03); border:1px solid rgba(192,132,252,0.12);
    border-radius:1rem; padding:1.5rem;
    transition:background 0.2s, border-color 0.2s;
  }
  .sd-incluye-card:hover { background:rgba(255,255,255,0.06); border-color:rgba(192,132,252,0.25); }
  .sd-incluye-num {
    font-family:'Poppins',sans-serif; font-weight:900; font-size:1.8rem;
    line-height:1; margin-bottom:0.75rem; opacity:0.7;
  }
  .sd-incluye-title {
    font-family:'Poppins',sans-serif; font-weight:700; font-size:0.9rem;
    color:#F0F0FF; margin-bottom:0.5rem;
  }
  .sd-incluye-desc { font-family:'Inter',sans-serif; font-size:0.78rem; color:rgba(240,240,255,0.45); line-height:1.6; }
  .sd-timeline {

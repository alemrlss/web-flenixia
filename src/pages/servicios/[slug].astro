<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-srv-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest<HTMLElement>('.faq-srv-item');
      const isOpen = item?.classList.contains('is-open');
      document.querySelectorAll('.faq-srv-item').forEach(el => el.classList.remove('is-open'));
      if (!isOpen && item) item.classList.add('is-open');
    });
  });
</script>

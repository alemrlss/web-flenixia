---
import Layout      from '../../layouts/Layout.astro';
import Navbar      from '../../components/Navbar.astro';
import Footer      from '../../components/Footer.astro';
import BookingWidget from '../../components/BookingWidget.astro';
---

<Layout
  title="Agente IA para Clinicas Esteticas - Flenixia"
  description="Automatiza la captacion, agendamiento y seguimiento de tus pacientes con un agente IA disenado para clinicas medico-esteticas. Responde 24/7, agenda citas y reduce no-shows."
>
  <Navbar />

  <!-- HERO -->
  <section class="ce-hero">
    <img
      src="https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=1920&q=80&fit=crop"
      alt="Clinica estetica" class="ce-hero-img"/>
    <div class="ce-hero-overlay"></div>

    <div class="ce-hero-inner">
      <div class="ce-hero-content">

        <div class="ce-eyebrow">
          <span class="ce-eyebrow-dot"></span>
          Agente especializado &middot; Clinicas Esteticas
        </div>

        <h1 class="ce-hero-title">
          Tu clinica captando citas<br/>
          <span class="ce-gradient">mientras descansas.</span>
        </h1>

        <p class="ce-hero-sub">
          Un agente de IA que atiende consultas, agenda citas y hace seguimiento &mdash; en WhatsApp y tu web, las 24 horas, con el tono de tu clinica.
        </p>

        <div class="ce-hero-ctas">
          <a href="#agenda" class="ce-cta-main">
            Solicitar diagnostico gratuito
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#como-funciona" class="ce-cta-ghost">Ver como funciona</a>
        </div>

        <div class="ce-stats">
          {[
            { num: '-35%', label: 'Menos no-shows' },
            { num: '+60%', label: 'Conversion de leads' },
            { num: '24/7', label: 'Sin intervencion humana' },
          ].map(s => (
            <div class="ce-stat">
              <span class="ce-stat-num">{s.num}</span>
              <span class="ce-stat-label">{s.label}</span>
            </div>
          ))}
        </div>

      </div>

      <!-- Notificacion + Chat preview -->
      <div class="ce-hero-right">

        <div class="ce-notif">
          <div class="ce-notif-icon">
            <svg width="16" height="16" fill="none" stroke="#22C55E" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9h18"/>
            </svg>
          </div>
          <div>
            <p class="ce-notif-title">Nueva cita confirmada</p>
            <p class="ce-notif-sub">Laura G. &middot; Jueves 17:00 &middot; Hidratacion facial</p>
          </div>
          <div class="ce-notif-live">
            <span class="ce-notif-dot"></span>
            Ahora
          </div>
        </div>

        <div class="ce-chat">
          <div class="ce-chat-header">
            <div class="ce-chat-av">C</div>
            <div>
              <p class="ce-chat-name">Clinica Bellezza &middot; IA</p>
              <p class="ce-chat-status"><span class="ce-live-dot"></span>En linea</p>
            </div>
          </div>
          <div class="ce-chat-body">
            <div class="ce-msg ce-bot">Hola! En que puedo ayudarte? 😊</div>
            <div class="ce-msg ce-user">Queria saber el precio de la hidratacion facial</div>
            <div class="ce-msg ce-bot">La hidratacion facial intensiva esta a <strong>85&euro;</strong> e incluye limpieza profunda + serum. Ves disponibilidad esta semana?</div>
            <div class="ce-msg ce-user">Si, el jueves por la tarde</div>
            <div class="ce-msg ce-bot">Tengo el <strong>jueves a las 17:00</strong>. Lo reservamos?</div>
            <div class="ce-msg ce-user">Perfecto, si</div>
            <div class="ce-msg ce-bot ce-confirm-msg">
              <svg width="13" height="13" fill="none" stroke="#22C55E" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              Cita confirmada &middot; Jueves 17:00
            </div>
            <div class="ce-typing">
              <span></span><span></span><span></span>
            </div>
          </div>
        </div>

        <div class="ce-hero-badge">
          <svg width="14" height="14" fill="none" stroke="#A78BFA" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
          </svg>
          Powered by Flenixia IA
        </div>

      </div>
    </div>
  </section>

  <!-- FUNCIONALIDADES -->
  <section id="como-funciona" class="ce-section-white">
    <div class="ce-container">
      <div class="ce-section-label-wrap"><span class="ce-label">Funcionalidades</span></div>
      <h2 class="ce-section-title">
        Todo lo que hace<br/>
        <span class="gradient-text">tu agente de IA.</span>
      </h2>
      <div class="ce-features-grid">
        {[
          { icon: 'M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z', title: 'Atiende consultas al instante', desc: 'Preguntas sobre tratamientos, precios y disponibilidad respondidas en segundos. Nunca en horas.' },
          { icon: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5', title: 'Agenda citas sin intervencion', desc: 'Sincronizado con tu calendario. Confirma, reagenda y cancela sin que nadie del equipo tenga que tocar nada.' },
          { icon: 'M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0', title: 'Recordatorios automaticos', desc: 'Envia recordatorios por WhatsApp 24h y 1h antes. Reduce no-shows hasta un 35%.' },
          { icon: 'M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z', title: 'WhatsApp y chat en web', desc: 'Donde tus pacientes ya estan. Sin apps nuevas, sin friccion, sin descargas.' },
          { icon: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5', title: 'Entrenado con tu clinica', desc: 'Conoce tus tratamientos, precios y protocolos. Habla con el tono de tu marca.' },
          { icon: 'M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3', title: 'Todo en tu CRM', desc: 'Cada conversacion queda registrada. Ningun lead se pierde ni queda sin seguimiento.' },
        ].map(f => (
          <div class="ce-feat-card">
            <div class="ce-feat-icon">
              <svg width="20" height="20" fill="none" stroke="#9333EA" stroke-width="1.75" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={f.icon}/>
              </svg>
            </div>
            <h3 class="ce-feat-title">{f.title}</h3>
            <p class="ce-feat-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- POR QUE CLINICAS -->
  <section class="ce-section-dark">
    <div class="ce-container">
      <div class="ce-pq-grid">
        <div>
          <span class="ce-label-dark">Por que clinicas esteticas</span>
          <h2 class="ce-section-title-dark">
            Disenado para<br/>
            <span class="ce-gradient">el sector estetico.</span>
          </h2>
          <div class="ce-razones">
            {[
              { titulo: 'Responde con tacto y calidez', desc: 'Entrenado para manejar consultas sensibles sobre tratamientos y precios sin perder la calidez de tu clinica.' },
              { titulo: 'Capta leads fuera de horario', desc: 'El 60% de las busquedas ocurren por la noche. Tu agente responde mientras tu equipo descansa.' },
              { titulo: 'Reduce el no-show radicalmente', desc: 'Recordatorios automaticos y confirmaciones reducen ausencias hasta un 35%, recuperando ingresos directos.' },
              { titulo: 'Integra con tu software', desc: 'Compatible con Doctolib, Fresha, Jane App y los principales gestores de clinicas.' },
            ].map(item => (
              <div class="ce-razon">
                <div class="ce-razon-dot"></div>
                <div>
                  <h3 class="ce-razon-title">{item.titulo}</h3>
                  <p class="ce-razon-desc">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="ce-chat-full">
          <div class="ce-chat-header">
            <div class="ce-chat-av">C</div>
            <div>
              <p class="ce-chat-name">Clinica Bellezza &middot; Agente IA</p>
              <p class="ce-chat-status"><span class="ce-live-dot"></span>En linea &middot; Responde al instante</p>
            </div>
          </div>
          <div class="ce-chat-body ce-chat-body-lg">
            <div class="ce-msg ce-bot">Hola! Soy el asistente virtual de Clinica Bellezza. En que puedo ayudarte? 😊</div>
            <div class="ce-msg ce-user">Hola, me interesa el tratamiento de relleno de labios</div>
            <div class="ce-msg ce-bot">El relleno de labios con acido hialuronico esta desde <strong>250&euro;</strong> segun el volumen. El resultado dura entre 6 y 12 meses. Tienes alguna alergia o tratamiento previo?</div>
            <div class="ce-msg ce-user">No, ninguna. Cuanto dura la sesion?</div>
            <div class="ce-msg ce-bot">La sesion dura unos <strong>45 minutos</strong>. Incluye valoracion previa y aplicacion. Puedes incorporarte ese mismo dia. Te agendo una consulta gratuita?</div>
            <div class="ce-msg ce-user">Si, el miercoles si puede ser</div>
            <div class="ce-msg ce-bot">Tengo disponibilidad el <strong>miercoles a las 11:00 y 16:30</strong>. Cual prefieres?</div>
            <div class="ce-msg ce-user">Las 11</div>
            <div class="ce-msg ce-bot ce-confirm-msg">
              <svg width="13" height="13" fill="none" stroke="#22C55E" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              Consulta confirmada &middot; Miercoles 11:00
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESULTADOS -->
  <section class="ce-section-white">
    <div class="ce-container">
      <div class="ce-section-label-wrap"><span class="ce-label">Resultados</span></div>
      <h2 class="ce-section-title">
        Numeros reales de<br/>
        <span class="gradient-text">clinicas como la tuya.</span>
      </h2>
      <div class="ce-results-grid">
        {[
          { num: '-35%', label: 'Menos no-shows',     desc: 'Reduccion media de ausencias gracias a los recordatorios automaticos por WhatsApp.' },
          { num: '+60%', label: 'Mas conversiones',   desc: 'Mas leads que pasan de consulta a cita confirmada, sin esfuerzo del equipo.' },
          { num: '24/7', label: 'Siempre disponible', desc: 'Tu agente atiende a las 2 de la madrugada un domingo. Sin coste adicional de personal.' },
          { num: '<30s', label: 'Tiempo de respuesta', desc: 'Respuesta inmediata vs. horas de espera. La diferencia entre captar o perder el lead.' },
        ].map(r => (
          <div class="ce-result-card">
            <div class="ce-result-num">{r.num}</div>
            <p class="ce-result-label">{r.label}</p>
            <p class="ce-result-desc">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section class="ce-section-gray">
    <div class="ce-container">
      <div class="ce-section-label-wrap"><span class="ce-label">Implementacion</span></div>
      <h2 class="ce-section-title">
        Activo en tu clinica<br/>
        <span class="gradient-text">en menos de una semana.</span>
      </h2>
      <div class="ce-proceso-grid">
        {[
          { n:'1', title:'Sesion de onboarding', desc:'Nos cuentas tu clinica, tratamientos, precios y tono de comunicacion. 60 minutos.' },
          { n:'2', title:'Entrenamos el agente', desc:'Configuramos y entrenamos el agente con toda tu informacion. Sin que toques nada tecnico.' },
          { n:'3', title:'Pruebas y validacion', desc:'Testamos todas las conversaciones posibles contigo antes de activar.' },
          { n:'4', title:'Activacion y seguimiento', desc:'Lanzamos en produccion y monitorizamos las primeras conversaciones reales.' },
        ].map(p => (
          <div class="ce-paso">
            <div class="ce-paso-n">{p.n}</div>
            <h3 class="ce-paso-title">{p.title}</h3>
            <p class="ce-paso-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AGENDA -->
  <section id="agenda" class="ce-section-agenda">
    <div class="ce-container">
      <h2 class="ce-agenda-title">Lista para automatizar<br/>tu clinica?</h2>
      <p class="ce-agenda-sub">Diagnostico gratuito de 30 minutos. Sin compromiso.</p>
      <BookingWidget />
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .ce-hero { position:relative; min-height:100vh; background:#1A1033; display:flex; align-items:center; overflow:hidden; }
  .ce-hero-img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.12; }
  .ce-hero-overlay { position:absolute; inset:0; background:linear-gradient(120deg,#1A1033 45%,rgba(26,16,51,0.6) 100%); }
  .ce-hero-inner { position:relative; z-index:1; max-width:1280px; margin:0 auto; padding:7rem 2.5rem 5rem; display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center; width:100%; }
  @media(max-width:900px){ .ce-hero-inner { grid-template-columns:1fr; } }
  .ce-eyebrow { display:inline-flex; align-items:center; gap:0.5rem; font-size:0.72rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#C084FC; background:rgba(192,132,252,0.1); border:1px solid rgba(192,132,252,0.25); border-radius:99px; padding:0.3rem 0.9rem; margin-bottom:1.5rem; }
  .ce-eyebrow-dot { width:6px; height:6px; border-radius:50%; background:#22C55E; box-shadow:0 0 6px rgba(34,197,94,0.7); }
  .ce-hero-title { font-weight:900; font-size:clamp(2.5rem,5.5vw,4rem); color:#fff; line-height:1.0; margin-bottom:1.25rem; letter-spacing:-0.02em; }
  .ce-gradient { background:linear-gradient(135deg,#C084FC,#A855F7,#F0ABFC); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
  .ce-hero-sub { font-size:1rem; color:rgba(255,255,255,0.58); line-height:1.75; margin-bottom:2rem; max-width:480px; }
  .ce-hero-ctas { display:flex; gap:0.75rem; flex-wrap:wrap; margin-bottom:2.5rem; }
  .ce-cta-main { display:inline-flex; align-items:center; gap:0.5rem; background:linear-gradient(135deg,#9333EA,#7C3AED); color:#fff; padding:0.8rem 1.75rem; border-radius:99px; font-size:0.9rem; font-weight:700; text-decoration:none; box-shadow:0 4px 20px rgba(147,51,234,0.45); transition:filter 0.2s,transform 0.2s; }
  .ce-cta-main:hover { filter:brightness(1.1); transform:translateY(-2px); }
  .ce-cta-ghost { display:inline-flex; align-items:center; padding:0.8rem 1.5rem; border-radius:99px; border:1px solid rgba(255,255,255,0.18); font-size:0.9rem; font-weight:600; color:rgba(255,255,255,0.65); text-decoration:none; transition:border-color 0.2s,color 0.2s; }
  .ce-cta-ghost:hover { border-color:rgba(255,255,255,0.5); color:#fff; }
  .ce-stats { display:flex; gap:2rem; flex-wrap:wrap; padding-top:2rem; border-top:1px solid rgba(255,255,255,0.1); }
  .ce-stat { display:flex; flex-direction:column; gap:2px; }
  .ce-stat-num { font-weight:900; font-size:1.6rem; background:linear-gradient(135deg,#C084FC,#A855F7); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; line-height:1; }
  .ce-stat-label { font-size:0.68rem; color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:0.06em; }
  .ce-hero-right { display:flex; flex-direction:column; gap:1rem; }
  .ce-notif { display:flex; align-items:center; gap:0.85rem; background:rgba(255,255,255,0.06); border:1px solid rgba(34,197,94,0.3); border-radius:0.875rem; padding:0.9rem 1.1rem; backdrop-filter:blur(12px); }
  .ce-notif-icon { width:36px; height:36px; border-radius:50%; flex-shrink:0; background:rgba(34,197,94,0.15); border:1px solid rgba(34,197,94,0.3); display:flex; align-items:center; justify-content:center; }
  .ce-notif-title { font-weight:700; font-size:0.82rem; color:#F0F0FF; }
  .ce-notif-sub { font-size:0.72rem; color:rgba(255,255,255,0.45); margin-top:1px; }
  .ce-notif-live { margin-left:auto; display:flex; align-items:center; gap:0.35rem; font-size:0.65rem; color:#4ADE80; white-space:nowrap; }
  .ce-notif-dot { width:6px; height:6px; border-radius:50%; background:#22C55E; box-shadow:0 0 6px rgba(34,197,94,0.8); }
  .ce-hero-badge { display:inline-flex; align-items:center; justify-content:center; gap:0.4rem; font-size:0.68rem; color:rgba(255,255,255,0.3); }
  .ce-chat, .ce-chat-full { background:#100C20; border:1px solid rgba(147,51,234,0.25); border-radius:1rem; overflow:hidden; }
  .ce-chat-header { background:rgba(147,51,234,0.12); border-bottom:1px solid rgba(147,51,234,0.2); padding:0.85rem 1.1rem; display:flex; align-items:center; gap:0.7rem; }
  .ce-chat-av { width:36px; height:36px; border-radius:50%; flex-shrink:0; background:linear-gradient(135deg,#9333EA,#C084FC); display:flex; align-items:center; justify-content:center; font-weight:800; color:#fff; font-size:0.95rem; }
  .ce-chat-name { font-weight:700; font-size:0.82rem; color:#F5F3FF; }
  .ce-chat-status { display:flex; align-items:center; gap:0.35rem; font-size:0.67rem; color:#A78BFA; margin-top:1px; }
  .ce-live-dot { width:6px; height:6px; border-radius:50%; background:#22C55E; box-shadow:0 0 5px rgba(34,197,94,0.8); display:inline-block; }
  .ce-chat-body { padding:1rem; display:flex; flex-direction:column; gap:0.55rem; }
  .ce-chat-body-lg { max-height:380px; overflow-y:auto; }
  .ce-msg { max-width:85%; padding:0.55rem 0.85rem; border-radius:0.875rem; font-size:0.78rem; line-height:1.5; }
  .ce-bot { background:#1E1640; border:1px solid #2D1B69; color:#E2DDFF; align-self:flex-start; border-bottom-left-radius:0.2rem; }
  .ce-user { background:#7C3AED; color:#fff; align-self:flex-end; border-bottom-right-radius:0.2rem; }
  .ce-confirm-msg { display:inline-flex; align-items:center; gap:0.5rem; background:#052E16; border:1px solid #166534; color:#4ADE80; font-weight:700; align-self:flex-start; border-bottom-left-radius:0.2rem; }
  .ce-typing { display:flex; gap:4px; align-items:center; padding:0.5rem 0.75rem; background:#1E1640; border-radius:0.875rem; width:fit-content; }
  .ce-typing span { width:6px; height:6px; border-radius:50%; background:#A78BFA; animation:ce-bounce 1.2s ease-in-out infinite; }
  .ce-typing span:nth-child(2){ animation-delay:0.18s; }
  .ce-typing span:nth-child(3){ animation-delay:0.36s; }
  @keyframes ce-bounce { 0%,80%,100%{transform:translateY(0);} 40%{transform:translateY(-5px);} }
  .ce-container { max-width:1200px; margin:0 auto; padding:0 2.5rem; }
  .ce-section-white  { background:#fff; padding:5.5rem 0; }
  .ce-section-dark   { background:#1A1033; padding:5.5rem 0; }
  .ce-section-gray   { background:#FAF8FF; padding:5.5rem 0; border-top:1px solid #EDE9FE; }
